# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it, and never put the token in front-end JS.

# Notion internal integration token (starts with "ntn_" or "secret_")
NOTION_TOKEN=

# Database (page) id — used as a fallback if the data source id is not set
NOTION_DATABASE_ID=244384dd16ee8008a64ac578cc9bcdbd

# Data source id — preferred (Notion 2025-09-03 API)
NOTION_DATA_SOURCE_ID=244384dd-16ee-80a4-9d5b-000bfbbd7dc0

# Public base URL of the deployed site (used by MkDocs site_url)
SITE_URL=https://chaoting.tw/leetcode/
